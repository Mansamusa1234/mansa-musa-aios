# ── Per-client deployment template ───────────────────────────────────────────
# Copy to config/clients/<clientname>.env, fill in, and deploy a separate instance
# (one Render blueprint + one Supabase project per client). This is all that changes
# between clients — the code is identical.

# Branding (shows on their dashboard + site)
BRAND_NAME=Acme Bistro OS
BRAND_TAGLINE=Acme Bistro, run by AI.
BRAND_ACCENT=#b5462f
BRAND_DOMAIN=acmebistro.co.uk
BRAND_POWERED_BY=Powered by Mansa Musa AI OS

# Their restaurant
RESTAURANT_NAME=Acme Bistro
RESTAURANT_CUISINE=Italian
RESTAURANT_CITY=Manchester
RESTAURANT_TIMEZONE=Europe/London
RESTAURANT_PHONE=
RESTAURANT_ADDRESS=

# Their own keys (each client uses THEIR own accounts — you never share keys)
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STRIPE_RESTRICTED_KEY=
STRIPE_SECRET_KEY=

# Their platform connections (added as they authorise each one)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_OAUTH_TOKEN=
TIKTOK_ACCESS_TOKEN=
TRIPADVISOR_API_KEY=
TRIPADVISOR_LOCATION_ID=
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Safety (start locked, flip on once the client trusts the drafts)
ALLOW_AUTO_PUBLISH=false
AUTO_REPLY_ENABLED=false
WEBHOOK_SECRET=
