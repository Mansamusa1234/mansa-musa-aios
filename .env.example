# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mansamusaai?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── OAuth Providers (optional — leave blank to disable) ──────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key at resend.com — free tier covers ~3,000 emails/month
RESEND_API_KEY="re_..."
# Must be a verified sender domain in Resend (or leave blank to use onboarding@resend.dev)
EMAIL_FROM="MansaMusaAI <noreply@mansamusaai.com>"

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs — create these in the Stripe dashboard
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
# Create a free database at upstash.com — copy the REST URL and token
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ─── Model Hub — additional AI providers (optional — leave blank to disable) ──
OPENAI_API_KEY="sk-..."
XAI_API_KEY="xai-..."
GOOGLE_AI_API_KEY="AIza..."
MISTRAL_API_KEY="..."

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
