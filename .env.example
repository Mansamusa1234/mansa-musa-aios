# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mansamusaai?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── OAuth Providers (optional — leave blank to disable) ──────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft Entra ID — register app at portal.azure.com
MICROSOFT_ENTRA_ID_CLIENT_ID=""
MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_TENANT_ID=""
# Apple Sign In — register at developer.apple.com
APPLE_ID=""
APPLE_TEAM_ID=""
APPLE_PRIVATE_KEY=""
APPLE_KEY_ID=""

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="MansaMusaAI <ai@mansamusainitiative.com>"
EMAIL_FROM_WELCOME="MansaMusaAI <greetings@mansamusainitiative.com>"

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PROFESSIONAL="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# ─── Paid Ads Growth Agent ────────────────────────────────────────────────────
# Meta Ads — use a server-side system-user token with the minimum required ad permissions.
META_AD_ACCOUNT_ID=""
META_ADS_ACCESS_TOKEN=""
META_GRAPH_API_VERSION="v23.0"
META_ADS_CURRENCY="GBP"

# Google Ads — OAuth access token + developer token. API version is configurable so it can be upgraded without a code change.
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_ACCESS_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_API_VERSION="v18"
GOOGLE_ADS_CURRENCY="GBP"

# TikTok for Business
TIKTOK_ADVERTISER_ID=""
TIKTOK_ADS_ACCESS_TOKEN=""
TIKTOK_ADS_CURRENCY="GBP"

# First-party website/CRM attribution endpoint: POST /api/ads/conversion
# ADS_OWNER_USER_ID is used for anonymous server-to-server events.
ADS_OWNER_USER_ID=""
ADS_CONVERSION_SECRET="generate-with: openssl rand -hex 32"

# ─── Cron Jobs ────────────────────────────────────────────────────────────────
CRON_SECRET="generate-with: openssl rand -hex 32"

# ─── Twilio (voice + WhatsApp) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="+44..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ─── Model Hub — additional AI providers (optional — leave blank to disable) ──
OPENAI_API_KEY="sk-..."
XAI_API_KEY="xai-..."
GOOGLE_AI_API_KEY="AIza..."
MISTRAL_API_KEY="..."
OPENROUTER_API_KEY="sk-or-v1-..."

# ─── Web Push Notifications ───────────────────────────────────────────────────
WEB_PUSH_PUBLIC_KEY="BG..."
WEB_PUSH_PRIVATE_KEY="..."
WEB_PUSH_EMAIL="mailto:support@mansamusainitiative.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BG..."

# ─── Analytics (all optional — leave blank to disable) ───────────────────────
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_ID="xxxxxxxxxx"
NEXT_PUBLIC_META_PIXEL_ID="000000000000000"
NEXT_PUBLIC_TIKTOK_PIXEL_ID="XXXXXXXXXXXXXXXXXX"

# ─── Sentry (error monitoring — optional but recommended for production) ─────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
