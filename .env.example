# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mansamusaai?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── OAuth Providers (optional — leave blank to disable) ──────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Microsoft Entra ID — register app at portal.azure.com
MICROSOFT_ENTRA_ID_CLIENT_ID=""
MICROSOFT_ENTRA_ID_CLIENT_SECRET=""
MICROSOFT_ENTRA_ID_TENANT_ID=""
# Apple Sign In — register at developer.apple.com
APPLE_ID=""
APPLE_TEAM_ID=""
APPLE_PRIVATE_KEY=""
APPLE_KEY_ID=""

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key at resend.com — free tier covers ~3,000 emails/month
RESEND_API_KEY="re_..."
# Must be a verified sender domain in Resend (or leave blank to use onboarding@resend.dev)
EMAIL_FROM="MansaMusaAI <noreply@mansamusaai.com>"

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs — create these in the Stripe dashboard
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
# Create a free database at upstash.com — copy the REST URL and token
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ─── Model Hub — additional AI providers (optional — leave blank to disable) ──
OPENAI_API_KEY="sk-..."
XAI_API_KEY="xai-..."
GOOGLE_AI_API_KEY="AIza..."
MISTRAL_API_KEY="..."
OPENROUTER_API_KEY="sk-or-v1-..."

# ─── Web Push Notifications ───────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY="BG..."
WEB_PUSH_PRIVATE_KEY="..."
WEB_PUSH_EMAIL="mailto:admin@mansamusaai.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BG..."

# ─── Analytics (all optional — leave blank to disable) ───────────────────────
# Google Analytics 4 — get from analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# Microsoft Clarity — get from clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID="xxxxxxxxxx"
# Meta (Facebook) Pixel — get from business.facebook.com → Events Manager
NEXT_PUBLIC_META_PIXEL_ID="000000000000000"
# TikTok Pixel — get from ads.tiktok.com → Assets → Events
NEXT_PUBLIC_TIKTOK_PIXEL_ID="XXXXXXXXXXXXXXXXXX"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
