# ── Mansa Musa AI OS — environment ───────────────────────────────────────────
# Copy to .env and fill in what you have. Leave the rest blank; those agents
# will simply run in DRAFT mode until their key is present.

# Agent brains (provide at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai          # openai | anthropic
LLM_MODEL=gpt-4o-mini        # or claude-haiku-4-5-20251001

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=        # service role key (server-side only, keep secret)

# ── White-label branding (change these per client; no code edits needed) ─────
BRAND_NAME=Mansa Musa AI OS
BRAND_TAGLINE=Your restaurant, run by AI.
BRAND_ACCENT=#c79a3b
BRAND_DOMAIN=mansamusainitiative.co.uk
BRAND_POWERED_BY=Mansa Musa AI OS

# Restaurant identity
RESTAURANT_NAME=Mansa Musa Kitchen & Lounge
RESTAURANT_CUISINE=Caribbean
RESTAURANT_CITY=Kings Heath, Birmingham
RESTAURANT_HOURS=Mon-Sat 12:00-22:00, Sun 12:00-20:00
RESTAURANT_TIMEZONE=Europe/London
RESTAURANT_PHONE=0121 529 1639
RESTAURANT_ADDRESS=32 Poplar Road, Kings Heath, Birmingham B14 7AD
# Google Business Profile is managed under this Google account: mansa1musas@gmail.com
# (used when you authorise the Google Business Profile OAuth in connectors/google_business.py)

# ── Platform connections (Phase 2 — official APIs only) ──────────────────────
# Meta (Facebook Page + Instagram Business share one app)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ID=

# TikTok (video-only). SELF_ONLY keeps test posts private until your app is audited.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY

# WhatsApp Cloud API (Meta) — customer messaging, booking confirmations, opt-in broadcasts
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Google Business Profile
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
GOOGLE_OAUTH_TOKEN=

# Tripadvisor Content API
TRIPADVISOR_API_KEY=
TRIPADVISOR_LOCATION_ID=

# Stripe (use a RESTRICTED, read-only key for reporting)
STRIPE_RESTRICTED_KEY=
# Stripe write key for creating Payment Links (deposits/catering/tickets) — keep separate & secret
STRIPE_SECRET_KEY=

# Email (Resend) — verify the mansa-musa.co.uk domain in Resend to send from this address
RESEND_API_KEY=
EMAIL_FROM=Mansa Musa <bookings@mansa-musa.co.uk>

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Behaviour ────────────────────────────────────────────────────────────────
# Global kill-switch for social posting. Keep false while you test.
ALLOW_AUTO_PUBLISH=false

# ── Reseller provisioning (YOUR tokens, only for scripts/provision_client.py) ─
# Leave blank unless you're auto-creating client instances. Without these the
# provisioning script runs in safe DRY-RUN mode.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=
SUPABASE_DB_PASSWORD=
SUPABASE_REGION=eu-west-2
RENDER_API_KEY=
RENDER_OWNER_ID=
GITHUB_REPO=https://github.com/Mansamusa1234/mansa-musa-aios

# Master switch for autonomous replies (email/review/social/customer). When false,
# every channel only DRAFTS for approval regardless of config/automation.yaml.
AUTO_REPLY_ENABLED=false

# Shared secret for inbound webhooks (email/review/social providers post here).
# Set the same value in the provider's webhook config; requests without it are rejected.
WEBHOOK_SECRET=
