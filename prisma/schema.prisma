generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String    @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  role                     Role      @default(USER)
  twoFactorEnabled         Boolean   @default(false)
  twoFactorSecret          String?
  onboardingComplete       Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  conversations            Conversation[]
  subscription             Subscription?
  usageRecords             UsageRecord[]
  affiliate                Affiliate?
  referredBy               String?
  referralCode             String?   @unique
  referralCommissions      Commission[] @relation("ReferrerCommissions")
  commissionLedger  CommissionLedger[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]
  trustedSessions          TrustedSession[]
  pushSubscriptions        PushSubscription[]
  newsletterSubscriber     NewsletterSubscriber?
  leads                    Lead[]
  receptionist             Receptionist?
  supportTickets           SupportTicket[]
  calendarBookings         CalendarBooking[]
  calendarAvailability     CalendarAvailability?
  approvalRequests         ApprovalRequest[]
  modelPreference          UserModelPreference?
  agentDeployments         AgentDeployment[]
  agentCompetitions        AgentCompetition[]
  wisdomAssets             WisdomAsset[]
  assetRatings             AssetRating[]
  agentRatings             AgentRating[]
  evidenceDocuments        EvidenceDocument[]
  evidenceChunks           EvidenceChunk[]
  exportedDocuments        ExportedDocument[]
  whatsAppMessages         WhatsAppMessage[]
  emailWorkflows           EmailWorkflow[]
  teamMemberships          TeamMember[]
  ownedTeams               Team[]           @relation("TeamOwner")
  apiKeys                  ApiKey[]
  agentListings            AgentListing[]   @relation("AgentListingSeller")
  agentPurchases           AgentPurchase[]  @relation("AgentPurchaseBuyer")
  workforceChats           WorkforceChat[]
  outreachCampaigns        OutreachCampaign[]
  activationNudge1SentAt   DateTime?
  activationNudge2SentAt   DateTime?
  activationNudge3SentAt   DateTime?
  referralNudgeSentAt      DateTime?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@id([identifier, token])
}

model TrustedSession {
  id         String   @id @default(cuid())
  userId     String
  deviceHash String
  label      String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, deviceHash])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  trialUsed            Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("message")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Affiliate {
  id              String   @id @default(cuid())
  userId          String   @unique
  code            String   @unique
  status          String   @default("pending")
  commissionRate  Float    @default(0.20)
  couponCode      String?
  stripeCouponId  String?
  paypalEmail     String?
  totalEarned     Float    @default(0)
  pendingPayout   Float    @default(0)
  lastPayoutAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals       Commission[] @relation("AffiliateCommissions")
  leaderboardEntries AffiliateLeaderboard[]
}

model Commission {
  id           String    @id @default(cuid())
  affiliateId  String
  referrerId   String
  amount       Float
  status       String    @default("pending")
  stripePaymentId String?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  affiliate    Affiliate @relation("AffiliateCommissions", fields: [affiliateId], references: [id], onDelete: Cascade)
  referrer     User      @relation("ReferrerCommissions", fields: [referrerId], references: [id], onDelete: Cascade)
}

model CommissionLedger {
  id         String   @id @default(cuid())
  userId     String
  amount     Float
  type       String
  note       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AffiliateLeaderboard {
  id          String    @id @default(cuid())
  affiliateId String    @unique
  rank        Int
  totalSales  Float     @default(0)
  period      String
  updatedAt   DateTime  @updatedAt
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  userId           String?   @unique
  status           String    @default("SUBSCRIBED")
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?
  unsubscribeToken String    @unique
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Lead {
  id           String   @id @default(cuid())
  userId       String
  name         String
  email        String?
  phone        String?
  company      String?
  source       String   @default("website")
  status       String   @default("new")
  notes        String?  @db.Text
  value        Float?
  convertedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  activities   LeadActivity[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

enum ReceptionistStatus {
  ACTIVE
  INACTIVE
}

model Receptionist {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String   @default("Aria")
  greeting      String   @default("Hello! Thank you for calling. How can I help you today?")
  persona       String   @default("Professional, friendly, and helpful") @db.Text
  businessHours String?
  isActive      Boolean  @default(true)
  phoneNumber   String?
  twilioSid     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceCalls    VoiceCall[]
  smsMessages   SmsMessage[]
}

model VoiceCall {
  id             String      @id @default(cuid())
  receptionistId String
  callSid        String      @unique
  from           String
  to             String
  status         String      @default("answered")
  transcript     String?     @db.Text
  summary        String?     @db.Text
  duration       Int?
  recordingUrl   String?
  createdAt      DateTime    @default(now())
  receptionist   Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
}

model SmsMessage {
  id             String      @id @default(cuid())
  receptionistId String
  from           String
  to             String
  body           String      @db.Text
  direction      String
  status         String      @default("received")
  twilioSid      String?     @unique
  createdAt      DateTime    @default(now())
  receptionist   Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
}

model CalendarAvailability {
  id          String   @id @default(cuid())
  userId      String   @unique
  timezone    String   @default("Europe/London")
  workdays    Json     @default("[1,2,3,4,5]")
  startTime   String   @default("09:00")
  endTime     String   @default("17:00")
  slotMins    Int      @default(30)
  bufferMins  Int      @default(15)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarBooking {
  id          String   @id @default(cuid())
  userId      String
  guestName   String
  guestEmail  String?
  title       String
  notes       String?  @db.Text
  startAt     DateTime
  endAt       DateTime
  status      String   @default("CONFIRMED")
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  body        String   @db.Text
  status      String   @default("OPEN")
  priority    String   @default("MEDIUM")
  aiResponse  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApprovalRequest {
  id          String   @id @default(cuid())
  userId      String
  type        String
  payload     Json
  status      String   @default("PENDING")
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserModelPreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  modelId    String
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentDeployment {
  id          String   @id @default(cuid())
  userId      String
  name        String
  agentType   String
  config      Json
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentMemory {
  id         String   @id @default(cuid())
  agentId    String
  key        String
  value      String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([agentId, key])
}

model AgentCompetition {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?  @db.Text
  prize       String?
  status      String   @default("ACTIVE")
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions AgentSubmission[]
}

model AgentSubmission {
  id            String          @id @default(cuid())
  competitionId String
  agentId       String
  score         Float           @default(0)
  rank          Int?
  createdAt     DateTime        @default(now())
  competition   AgentCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}

model WisdomAsset {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  type        String
  url         String?
  price       Float    @default(0)
  tags        String[]
  downloads   Int      @default(0)
  rating      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings     AssetRating[]
}

model AssetRating {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  rating    Int
  review    String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     WisdomAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@unique([userId, assetId])
}

model AgentListing {
  id          String   @id @default(cuid())
  sellerId    String
  name        String
  description String?  @db.Text
  price       Float    @default(0)
  agentType   String
  config      Json
  downloads   Int      @default(0)
  rating      Float    @default(0)
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  seller      User     @relation("AgentListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  purchases   AgentPurchase[]
  ratings     AgentRating[]
}

model AgentPurchase {
  id        String   @id @default(cuid())
  buyerId   String
  listingId String
  amount    Float
  createdAt DateTime @default(now())
  buyer     User        @relation("AgentPurchaseBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  listing   AgentListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model AgentRating {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  rating    Int
  review    String?  @db.Text
  createdAt DateTime @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   AgentListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@unique([userId, listingId])
}

model EvidenceDocument {
  id          String   @id @default(cuid())
  userId      String
  title       String
  type        String
  content     String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks      EvidenceChunk[]
}

model EvidenceChunk {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  content    String   @db.Text
  embedding  Float[]
  createdAt  DateTime @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   EvidenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ExportedDocument {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  content     String   @db.Text
  format      String   @default("pdf")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatsAppMessage {
  id             String   @id @default(cuid())
  userId         String
  from           String
  to             String
  body           String   @db.Text
  direction      String
  status         String   @default("received")
  twilioSid      String?  @unique
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailWorkflow {
  id          String   @id @default(cuid())
  userId      String
  name        String
  trigger     String
  steps       Json
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  invites   TeamInvite[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String
  keyHash   String   @unique
  prefix    String
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkforceChat {
  id        String   @id @default(cuid())
  userId    String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/* ── Outreach / Cold Email ───────────────────────────────────── */

enum OutreachStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  FAILED
  UNSUBSCRIBED
}

model OutreachCampaign {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  industry    String?
  subject     String
  status      String   @default("ACTIVE")
  sentCount   Int      @default(0)
  openCount   Int      @default(0)
  replyCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  contacts OutreachContact[]
}

model OutreachContact {
  id           String         @id @default(cuid())
  campaignId   String
  name         String
  email        String
  company      String?
  industry     String?
  aiDraft      String?        @db.Text
  status       OutreachStatus @default(DRAFT)
  sentAt       DateTime?
  openedAt     DateTime?
  repliedAt    DateTime?  
  createdAt    DateTime       @default(now())

  campaign OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

/* ── Content Approval Queue ─────────────────────────────────── */

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SENT
}

model ContentQueue {
  id          String         @id @default(cuid())
  type        String         // "social_post" | "email" | "lead_followup" | "pr"
  platform    String?        // "twitter" | "linkedin" | "instagram" | "email" etc
  title       String
  content     String         @db.Text
  metadata    Json?
  status      ApprovalStatus @default(PENDING)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

/* ── Legal Dictionary ───────────────────────────────────────── */

model LegalTerm {
  id          String   @id @default(cuid())
  term        String   @unique
  definition  String   @db.Text
  category    String?
  jurisdiction String?
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/* ── Coupon / Discounts ─────────────────────────────────────── */

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  stripeCouponId  String?
  discountPercent Int
  maxRedemptions  Int?
  redemptions     Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

/* ── Instagram Token ────────────────────────────────────────── */

model InstagramToken {
  id          String   @id @default(cuid())
  accessToken String   @db.Text
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt
}

/* ── Wisdom Leaderboard ─────────────────────────────────────── */

model WisdomLeaderboard {
  id          String   @id @default(cuid())
  userId      String   @unique
  score       Float    @default(0)
  rank        Int?
  updatedAt   DateTime @updatedAt
}

/* ── Arena Sessions ─────────────────────────────────────────── */

model ArenaSession {
  id          String   @id @default(cuid())
  userId      String
  model1      String
  model2      String
  prompt      String   @db.Text
  response1   String?  @db.Text
  response2   String?  @db.Text
  winner      String?
  savedAt     DateTime?
  createdAt   DateTime @default(now())
}

/* ── Competition ────────────────────────────────────────────── */

model Competition {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  prize       String?
  status      String   @default("ACTIVE")
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     CompetitionEntry[]
}

model CompetitionEntry {
  id            String      @id @default(cuid())
  competitionId String
  userId        String
  content       String      @db.Text
  score         Float       @default(0)
  rank          Int?
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}
