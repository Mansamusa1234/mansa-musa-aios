generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INACTIVE
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  role              Role      @default(USER)
  referralCode      String?   @unique
  referredByUserId  String?
  failedLoginAttempts Int     @default(0)
  lockedUntil       DateTime?
  twoFactorSecret   String?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorBackupCodes String? @db.Text
  onboardingComplete Boolean  @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  subscription      Subscription?
  conversations     Conversation[]
  usageRecords      UsageRecord[]
  agentMemories     AgentMemory[]
  referralsMade     Referral[]    @relation("ReferralsMade")
  referralReceived  Referral?     @relation("ReferralsReceived")
  affiliate         Affiliate?
  arenaSessions     ArenaSession[]
  wisdomMemories    WisdomMemory[]
  referredBy        User?              @relation("ReferredBy", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers     User[]             @relation("ReferredBy")
  commissionLedger  CommissionLedger[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]
  trustedSessions          TrustedSession[]
  pushSubscriptions        PushSubscription[]
  newsletterSubscriber     NewsletterSubscriber?
  leads                    Lead[]
  receptionist             Receptionist?
  supportTickets           SupportTicket[]
  calendarBookings         CalendarBooking[]
  calendarAvailability     CalendarAvailability?
  approvalRequests         ApprovalRequest[]
  modelPreference          UserModelPreference?
  agentDeployments         AgentDeployment[]
  agentCompetitions        AgentCompetition[]
  wisdomAssets             WisdomAsset[]
  assetRatings             AssetRating[]
  agentRatings             AgentRating[]
  evidenceDocuments        EvidenceDocument[]
  evidenceChunks           EvidenceChunk[]
  exportedDocuments        ExportedDocument[]
  whatsAppMessages         WhatsAppMessage[]
  emailWorkflows           EmailWorkflow[]
  teamMemberships          TeamMember[]
  ownedTeams               Team[]           @relation("TeamOwner")
  apiKeys                  ApiKey[]
  agentListings            AgentListing[]   @relation("AgentListingSeller")
  agentPurchases           AgentPurchase[]  @relation("AgentPurchaseBuyer")
  workforceChats           WorkforceChat[]
  activationNudge1SentAt   DateTime?
  activationNudge2SentAt   DateTime?
  activationNudge3SentAt   DateTime?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt              DateTime?
  trialUsed                Boolean            @default(false)
  trialEndingNotifiedAt    DateTime?
  winBack1SentAt           DateTime?
  winBack2SentAt           DateTime?
  winBack3SentAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  agentId   String?
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String       @db.Text
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id           String   @id @default(cuid())
  userId       String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  model        String
  provider     String   @default("anthropic")
  costUsdMicro Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserModelPreference {
  id       String @id @default(cuid())
  userId   String @unique
  mode     String @default("auto")
  provider String @default("anthropic")
  modelId  String @default("claude-haiku-4-5-20251001")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentMemory {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
}

model EvidenceDocument {
  id          String   @id @default(cuid())
  userId      String
  filename    String
  mimeType    String
  sizeBytes   Int
  sourceType  String   @default("USER_UPLOAD")
  status      String   @default("READY")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks EvidenceChunk[]

  @@index([userId, createdAt])
}

model EvidenceChunk {
  id           String   @id @default(cuid())
  documentId   String
  userId       String
  text         String   @db.Text
  pageNumber   Int?
  sectionLabel String?
  createdAt    DateTime @default(now())

  document EvidenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
}

model ExportedDocument {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String
  content   String   @db.Text
  sources   String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Referral {
  id             String    @id @default(cuid())
  referrerId     String
  referredUserId String    @unique
  status         String    @default("SIGNED_UP")
  rewardCents    Int       @default(0)
  createdAt      DateTime  @default(now())
  convertedAt    DateTime?

  referrer     User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferralsReceived", fields: [referredUserId], references: [id], onDelete: Cascade)

  ledgerEntry CommissionLedger?
}

enum AffiliateTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Affiliate {
  id               String        @id @default(cuid())
  userId           String        @unique
  code             String        @unique
  status           String        @default("APPROVED")
  tier             AffiliateTier @default(BRONZE)
  commissionRate   Int           @default(20)
  recurringRate    Int           @default(20)
  clicks           Int           @default(0)
  couponCode       String?       @unique
  stripeCouponId   String?
  socialHandle     String?
  paypalEmail      String?
  bankDetails      String?       @db.Text
  parentAffiliateId String?
  tier2Rate        Int           @default(5)
  createdAt        DateTime      @default(now())

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversions     AffiliateConversion[]
  clickLogs       AffiliateClick[]
  payoutRequests  AffiliatePayoutRequest[]
  childAffiliates Affiliate[]           @relation("AffiliateHierarchy")
  parentAffiliate Affiliate?            @relation("AffiliateHierarchy", fields: [parentAffiliateId], references: [id])
}

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  ip          String?
  userAgent   String?
  referrer    String?
  country     String?
  converted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
}

model AffiliateConversion {
  id                  String    @id @default(cuid())
  affiliateId         String
  referredUserId      String    @unique
  status              String    @default("SIGNED_UP")
  commissionCents     Int       @default(0)
  recurringTotal      Int       @default(0)
  stripeSubscriptionId String?
  stripePriceId       String?
  createdAt           DateTime  @default(now())
  convertedAt         DateTime?
  lastRenewalAt       DateTime?

  affiliate   Affiliate              @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  ledgerEntry CommissionLedger?
  renewals    AffiliateRenewal[]
}

model AffiliateRenewal {
  id              String   @id @default(cuid())
  conversionId    String
  amountCents     Int
  commissionCents Int
  invoiceId       String?  @unique
  paidAt          DateTime @default(now())

  conversion AffiliateConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
}

model AffiliatePayoutRequest {
  id            String              @id @default(cuid())
  affiliateId   String
  amountCents   Int
  status        PayoutRequestStatus @default(PENDING)
  method        String              @default("bank")
  notes         String?             @db.Text
  adminNote     String?
  processedAt   DateTime?
  createdAt     DateTime            @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
}

/* ── Commission ledger (admin-approval, manual payout) ──────── */

enum LedgerStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum LedgerSourceType {
  REFERRAL
  AFFILIATE
}

model CommissionLedger {
  id                    String           @id @default(cuid())
  userId                String
  sourceType            LedgerSourceType
  referralId            String?          @unique
  affiliateConversionId String?          @unique
  amountCents           Int
  status                LedgerStatus     @default(PENDING)
  approvedAt            DateTime?
  approvedByUserId      String?
  paidAt                DateTime?
  paidByUserId          String?
  notes                 String?          @db.Text
  createdAt             DateTime         @default(now())

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  referral            Referral?            @relation(fields: [referralId], references: [id])
  affiliateConversion AffiliateConversion? @relation(fields: [affiliateConversionId], references: [id])
}

/* ── Wisdom Arena ─────────────────────────────────────────── */

enum ArenaStatus {
  RUNNING
  DEBATING
  CRITIQUING
  IMPROVING
  SCORING
  SYNTHESIZING
  DONE
  FAILED
}

enum ResponseRound {
  INITIAL
  CRITIQUE
  IMPROVED
}

model Agent {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  role         String
  description  String
  systemPrompt String   @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  responses AgentResponse[]
  scores    AgentScore[]
}

model ArenaSession {
  id          String      @id @default(cuid())
  userId      String
  question    String      @db.Text
  status      ArenaStatus @default(RUNNING)
  error       String?
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses AgentResponse[]
  scores    AgentScore[]
  synthesis FinalSynthesis?
  memory    WisdomMemory?
}

model AgentResponse {
  id        String        @id @default(cuid())
  sessionId String
  agentId   String
  round     ResponseRound
  content   String        @db.Text
  createdAt DateTime      @default(now())

  session ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent   Agent        @relation(fields: [agentId], references: [id])

  @@unique([sessionId, agentId, round])
}

model AgentScore {
  id            String   @id @default(cuid())
  sessionId     String
  agentId       String
  truth         Int
  evidence      Int
  depth         Int
  practicality  Int
  riskAwareness Int
  originality   Int
  clarity       Int
  longTermValue Int
  total         Int
  rationale     String   @db.Text
  createdAt     DateTime @default(now())

  session ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent   Agent        @relation(fields: [agentId], references: [id])

  @@unique([sessionId, agentId])
}

model FinalSynthesis {
  id        String   @id @default(cuid())
  sessionId String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())

  session ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model WisdomMemory {
  id        String   @id @default(cuid())
  userId    String
  sessionId String   @unique
  question  String   @db.Text
  summary   String   @db.Text
  savedAt   DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

/* ── Phase 6: Enterprise Authentication ──────────────────────── */

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  ACCOUNT_LOCKED
  SUSPICIOUS_LOGIN
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  EMAIL_CHANGED
  SESSION_REVOKED
}

model AuditLog {
  id        String         @id @default(cuid())
  userId    String?
  event     AuditEventType
  ip        String?
  userAgent String?
  metadata  String?        @db.Text
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model TrustedSession {
  id         String    @id @default(cuid())
  userId     String
  tokenId    String    @unique
  ip         String?
  userAgent  String?
  rememberMe Boolean   @default(false)
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/* ── Growth Engine ────────────────────────────────────────── */

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  userId       String?          @unique
  status       SubscriberStatus @default(SUBSCRIBED)
  unsubscribeToken String       @unique
  subscribedAt DateTime         @default(now())
  unsubscribedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model EmailCampaign {
  id          String    @id @default(cuid())
  subject     String
  bodyHtml    String    @db.Text
  status      String    @default("DRAFT")
  recipientCount Int    @default(0)
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
}

/* ── CRM ──────────────────────────────────────────────────── */

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

model Lead {
  id          String     @id @default(cuid())
  userId      String
  name        String
  email       String?
  phone       String?
  company     String?
  source      String?
  stage       LeadStage  @default(NEW)
  value       Int        @default(0)
  notes       String?    @db.Text
  assignedTo  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities  LeadActivity[]

  @@index([userId, stage])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  note      String?  @db.Text
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

/* ── WhatsApp ─────────────────────────────────────────────── */

enum WhatsAppDirection {
  INBOUND
  OUTBOUND
}

model WhatsAppMessage {
  id          String             @id @default(cuid())
  userId      String
  from        String
  to          String
  body        String             @db.Text
  direction   WhatsAppDirection
  twilioSid   String?            @unique
  status      String             @default("received")
  mediaUrl    String?
  createdAt   DateTime           @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/* ── Email Automation ─────────────────────────────────────── */

enum WorkflowTrigger {
  LEAD_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  TRIAL_STARTED
  TRIAL_ENDING
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_CANCELLED
  MANUAL
}

model EmailWorkflow {
  id          String           @id @default(cuid())
  userId      String
  name        String
  trigger     WorkflowTrigger
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps       EmailWorkflowStep[]
  runs        EmailWorkflowRun[]
}

model EmailWorkflowStep {
  id           String   @id @default(cuid())
  workflowId   String
  stepOrder    Int
  delayHours   Int      @default(0)
  subject      String
  bodyHtml     String   @db.Text
  createdAt    DateTime @default(now())

  workflow     EmailWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model EmailWorkflowRun {
  id          String            @id @default(cuid())
  workflowId  String
  toEmail     String
  toName      String?
  status      WorkflowRunStatus @default(PENDING)
  currentStep Int               @default(0)
  startedAt   DateTime          @default(now())
  completedAt DateTime?

  workflow    EmailWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

/* ── AI Receptionist ──────────────────────────────────────── */

model Receptionist {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String   @default("AI Assistant")
  greeting       String   @default("Hello! How can I help you today?") @db.Text
  persona        String   @default("professional, friendly, helpful") @db.Text
  businessHours  String?
  widgetColor    String   @default("#6366f1")
  isActive       Boolean  @default(true)
  totalChats     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  twilioNumber   String?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats          ReceptionistChat[]
  voiceCalls     VoiceCall[]
}

model ReceptionistChat {
  id              String   @id @default(cuid())
  receptionistId  String
  visitorName     String?
  visitorEmail    String?
  messages        String   @db.Text
  createdAt       DateTime @default(now())

  receptionist Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
}

/* ── Workforce OS ─────────────────────────────────────────── */

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id          String         @id @default(cuid())
  userId      String
  subject     String
  body        String         @db.Text
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  aiResponse  String?        @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model CalendarBooking {
  id              String   @id @default(cuid())
  userId          String
  guestName       String
  guestEmail      String
  guestPhone      String?
  title           String
  notes           String?  @db.Text
  startAt         DateTime
  endAt           DateTime
  status          String   @default("CONFIRMED")
  cancellationToken String @unique @default(cuid())
  reminderSent    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
}

model CalendarAvailability {
  id        String   @id @default(cuid())
  userId    String   @unique
  timezone  String   @default("Europe/London")
  slotMins  Int      @default(30)
  bufferMins Int     @default(15)
  monday    String?
  tuesday   String?
  wednesday String?
  thursday  String?
  friday    String?
  saturday  String?
  sunday    String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApprovalRequest {
  id          String   @id @default(cuid())
  userId      String
  agentId     String?
  action      String
  payload     String   @db.Text
  status      String   @default("PENDING")
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/* ── Phase 6: AI Wisdom Economy ──────────────────────────────── */

enum WisdomCategory {
  NEWS
  FINANCE
  RESEARCH
  CODING
  MARKETING
  SALES
  STRATEGY
  OPERATIONS
}

enum CompStatus {
  RUNNING
  SCORING
  DONE
  FAILED
}

model MarketplaceAgent {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  category     WisdomCategory
  description  String          @db.Text
  systemPrompt String          @db.Text
  icon         String
  color        String          @default("#6366f1")
  planGate     String          @default("basic")
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())

  stats       AgentMarketStats?
  deployments AgentDeployment[]
  entries     CompetitionEntry[]
  ratings     AgentRating[]
  assets      WisdomAsset[]
  listing     AgentListing?
}

model AgentMarketStats {
  id            String   @id @default(cuid())
  agentId       String   @unique
  wins          Int      @default(0)
  losses        Int      @default(0)
  totalSessions Int      @default(0)
  winRate       Float    @default(0)
  accuracyScore Float    @default(0)
  avgRating     Float    @default(0)
  ratingCount   Int      @default(0)
  updatedAt     DateTime @updatedAt

  agent MarketplaceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model AgentDeployment {
  id         String   @id @default(cuid())
  userId     String
  agentId    String
  isActive   Boolean  @default(true)
  deployedAt DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent MarketplaceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
}

model AgentCompetition {
  id          String         @id @default(cuid())
  userId      String
  prompt      String         @db.Text
  category    WisdomCategory
  status      CompStatus     @default(RUNNING)
  error       String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries CompetitionEntry[]
  asset   WisdomAsset?
}

model CompetitionEntry {
  id            String   @id @default(cuid())
  competitionId String
  agentId       String
  response      String   @db.Text
  score         Float    @default(0)
  rank          Int      @default(0)
  rationale     String   @db.Text @default("")

  competition AgentCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  agent       MarketplaceAgent @relation(fields: [agentId], references: [id])
}

model WisdomAsset {
  id            String         @id @default(cuid())
  competitionId String         @unique
  agentId       String
  userId        String
  title         String
  content       String         @db.Text
  category      WisdomCategory
  prompt        String         @db.Text
  views         Int            @default(0)
  saves         Int            @default(0)
  avgRating     Float          @default(0)
  ratingCount   Int            @default(0)
  createdAt     DateTime       @default(now())

  competition AgentCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  agent       MarketplaceAgent @relation(fields: [agentId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings     AssetRating[]
}

model AssetRating {
  id      String @id @default(cuid())
  assetId String
  userId  String
  rating  Int

  asset WisdomAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assetId, userId])
}

model AgentRating {
  id        String   @id @default(cuid())
  agentId   String
  userId    String
  rating    Int
  createdAt DateTime @default(now())

  agent MarketplaceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
}

/* ── Team / Enterprise ────────────────────────────────────── */

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  plan      String   @default("starter")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members TeamMember[]
  invites TeamInvite[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamInvite {
  id         String    @id @default(cuid())
  teamId     String
  email      String
  role       TeamRole  @default(MEMBER)
  token      String    @unique @default(cuid())
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/* ── Agent Marketplace ────────────────────────────────────── */

model AgentListing {
  id          String   @id @default(cuid())
  agentId     String   @unique
  sellerId    String
  priceCents  Int
  description String?  @db.Text
  downloads   Int      @default(0)
  revenue     Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  agent     MarketplaceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  seller    User             @relation("AgentListingSeller", fields: [sellerId], references: [id])
  purchases AgentPurchase[]
}

model AgentPurchase {
  id         String   @id @default(cuid())
  listingId  String
  buyerId    String
  priceCents Int
  createdAt  DateTime @default(now())

  listing AgentListing @relation(fields: [listingId], references: [id])
  buyer   User         @relation("AgentPurchaseBuyer", fields: [buyerId], references: [id])

  @@unique([listingId, buyerId])
}

/* ── Workforce C-Suite Chat ───────────────────────────────── */

model WorkforceChat {
  id        String   @id @default(cuid())
  userId    String
  agentRole String
  messages  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agentRole])
}

/* ── Voice Calls ──────────────────────────────────────────── */

model VoiceCall {
  id             String    @id @default(cuid())
  receptionistId String
  callSid        String    @unique
  from           String
  to             String
  status         String    @default("initiated")
  duration       Int?
  transcript     String?   @db.Text
  recordingUrl   String?
  createdAt      DateTime  @default(now())
  endedAt        DateTime?

  receptionist Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
}

/* ── Agent Intelligence Reports ────────────────────────────── */

model AgentIntelligenceReport {
  id        String   @id @default(cuid())
  agentRole String
  date      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentRole, date])
  @@index([date])
}

/* ── Outreach Campaigns ─────────────────────────────────────── */

enum OutreachStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  FAILED
}

model OutreachCampaign {
  id          String   @id @default(cuid())
  name        String
  industry    String?
  subject     String
  status      String   @default("ACTIVE")
  sentCount   Int      @default(0)
  openCount   Int      @default(0)
  replyCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts OutreachContact[]
}

model OutreachContact {
  id           String         @id @default(cuid())
  campaignId   String
  name         String
  email        String
  company      String?
  industry     String?
  aiDraft      String?        @db.Text
  status       OutreachStatus @default(DRAFT)
  sentAt       DateTime?
  openedAt     DateTime?
  repliedAt    DateTime?
  createdAt    DateTime       @default(now())

  campaign OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

/* ── Content Approval Queue ─────────────────────────────────── */

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SENT
}

model ContentQueue {
  id          String         @id @default(cuid())
  type        String         // "social_post" | "email" | "lead_followup" | "pr"
  platform    String?        // "twitter" | "linkedin" | "instagram" | "email" etc
  title       String
  content     String         @db.Text
  metadata    String?        @db.Text  // JSON extras (leadId, scheduledFor, etc)
  status      ApprovalStatus @default(PENDING)
  approvedAt  DateTime?
  rejectedAt  DateTime?
  sentAt      DateTime?
  scheduledFor DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
