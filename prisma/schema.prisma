generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INACTIVE
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  role              Role      @default(USER)
  referralCode      String?   @unique
  referredByUserId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  subscription      Subscription?
  conversations     Conversation[]
  usageRecords      UsageRecord[]
  agentMemories     AgentMemory[]
  referralsMade     Referral[]    @relation("ReferralsMade")
  referralReceived  Referral?     @relation("ReferralsReceived")
  affiliate         Affiliate?
  arenaSessions     ArenaSession[]
  wisdomMemories    WisdomMemory[]
  referredBy        User?              @relation("ReferredBy", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers     User[]             @relation("ReferredBy")
  commissionLedger  CommissionLedger[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  agentId   String?
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String       @db.Text
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id           String   @id @default(cuid())
  userId       String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  model        String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentMemory {
  id        String   @id @default(cuid())
  userId    String
  agentId   String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
}

model Referral {
  id             String    @id @default(cuid())
  referrerId     String
  referredUserId String    @unique
  status         String    @default("SIGNED_UP")
  rewardCents    Int       @default(0)
  createdAt      DateTime  @default(now())
  convertedAt    DateTime?

  referrer     User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferralsReceived", fields: [referredUserId], references: [id], onDelete: Cascade)

  ledgerEntry CommissionLedger?
}

model Affiliate {
  id             String   @id @default(cuid())
  userId         String   @unique
  code           String   @unique
  status         String   @default("APPROVED")
  commissionRate Int      @default(20)
  clicks         Int      @default(0)
  createdAt      DateTime @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversions AffiliateConversion[]
}

model AffiliateConversion {
  id              String    @id @default(cuid())
  affiliateId     String
  referredUserId  String    @unique
  status          String    @default("SIGNED_UP")
  commissionCents Int       @default(0)
  createdAt       DateTime  @default(now())
  convertedAt     DateTime?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  ledgerEntry CommissionLedger?
}

/* ── Commission ledger (admin-approval, manual payout) ──────── */

enum LedgerStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum LedgerSourceType {
  REFERRAL
  AFFILIATE
}

model CommissionLedger {
  id                    String           @id @default(cuid())
  userId                String
  sourceType            LedgerSourceType
  referralId            String?          @unique
  affiliateConversionId String?          @unique
  amountCents           Int
  status                LedgerStatus     @default(PENDING)
  approvedAt            DateTime?
  approvedByUserId      String?
  paidAt                DateTime?
  paidByUserId          String?
  notes                 String?          @db.Text
  createdAt             DateTime         @default(now())

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  referral            Referral?            @relation(fields: [referralId], references: [id])
  affiliateConversion AffiliateConversion? @relation(fields: [affiliateConversionId], references: [id])
}

/* ── Wisdom Arena ─────────────────────────────────────────── */

enum ArenaStatus {
  RUNNING
  DEBATING
  CRITIQUING
  IMPROVING
  SCORING
  SYNTHESIZING
  DONE
  FAILED
}

enum ResponseRound {
  INITIAL
  CRITIQUE
  IMPROVED
}

model Agent {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  role         String
  description  String
  systemPrompt String   @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  responses AgentResponse[]
  scores    AgentScore[]
}

model ArenaSession {
  id          String      @id @default(cuid())
  userId      String
  question    String      @db.Text
  status      ArenaStatus @default(RUNNING)
  error       String?
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses AgentResponse[]
  scores    AgentScore[]
  synthesis FinalSynthesis?
  memory    WisdomMemory?
}

model AgentResponse {
  id        String        @id @default(cuid())
  sessionId String
  agentId   String
  round     ResponseRound
  content   String        @db.Text
  createdAt DateTime      @default(now())

  session ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent   Agent        @relation(fields: [agentId], references: [id])

  @@unique([sessionId, agentId, round])
}

model AgentScore {
  id            String   @id @default(cuid())
  sessionId     String
  agentId       String
  truth         Int
  evidence      Int
  depth         Int
  practicality  Int
  riskAwareness Int
  originality   Int
  clarity       Int
  longTermValue Int
  total         Int
  rationale     String   @db.Text
  createdAt     DateTime @default(now())

  session ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent   Agent        @relation(fields: [agentId], references: [id])

  @@unique([sessionId, agentId])
}

model FinalSynthesis {
  id        String   @id @default(cuid())
  sessionId String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())

  session ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model WisdomMemory {
  id        String   @id @default(cuid())
  userId    String
  sessionId String   @unique
  question  String   @db.Text
  summary   String   @db.Text
  savedAt   DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ArenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
